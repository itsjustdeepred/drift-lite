        <item name="backgroundTint">#282828</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">#282828</item>
        <item name="colorSurfaceContainerHigh">#282828</item>
        <item name="colorSurfaceContainerHighest">#333333</item>
    </style>

